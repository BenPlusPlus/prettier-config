{
  "name": "@excalsoft/prettier-config",
  "version": "1.0.0",
  "description": "@excalsoft Prettier config",
  "keywords": [
    "prettier",
    "prettierconfig",
    "excalsoft"
  ],
  "author": {
    "name": "Excalibur Software",
    "email": "dev@excalsoft.net"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js"
  ],
  "homepage": "https://github.com/benplusplus/prettier-config#readme",
  "repository": {
    "url": "git+https://github.com/benplusplus/prettier-config.git"
  },
  "bugs": {
    "url": "https://github.com/benplusplus/prettier-config/issues"
  },
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install",
    "changeset:publish": "changeset publish",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint ."
  },
  "private": false,
  "prettier": "./index.js",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 18"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "3.0.1",
    "@excalsoft/eslint-config": "1.0.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "prettier": "3.8.1"
  }
}
